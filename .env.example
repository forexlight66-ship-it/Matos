# Deriv OAuth
DERIV_APP_ID=your_app_id
DERIV_CLIENT_SECRET=your_client_secret
DERIV_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Platform accounts (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Password reset emails (Resend)
RESEND_API_KEY=your_resend_api_key
# Use a sender address from a verified Resend domain.
RESEND_FROM=MozHyper <noreply@your-verified-domain.com>
